{
  "manifest_version": 3,
  "name": "Spotify AI Generator Playlist",
  "version": "4.2.1",
  "description": "🎵 AI-powered playlist generator for Spotify • Choose genres, set song count • Generate unique playlists with AI",
  "permissions": ["storage", "identity"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://open.spotify.com/*",
    "https://accounts.spotify.com/*",
    "https://api.spotify.com/*",
    "https://polar-ravine-64133-f97528c41675.herokuapp.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["config.js", "styles.js", "ui.js", "radio.js", "utils.js", "api.js", "buttons.js", "auth.js", "content.js"]
    }
  ]
}
